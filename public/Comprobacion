<?php
$numeros = fgets(STDIN);
$operacion = explode(" ",trim($numeros));

switch ($operacion[0]) {
    case '+':
        echo '<p>'.$operacion[1].' + '.$operacion[2].' = '.$operacion[1]+$operacion[2].'</p>' ;
        break;
    case '-':
        echo '<p>'.$operacion[1].' - '.$operacion[2].' = '.$operacion[1]-$operacion[2].'</p>' ;
        break;
    case 'x':
        echo '<p>'.$operacion[1].' x '.$operacion[2].' = '.$operacion[1]*$operacion[2].'</p>' ;
        break;
    case ':':
        echo '<p>'.$operacion[1].' : '.$operacion[2].' = '.$operacion[1]/$operacion[2].'</p>' ;
        break;
    default:
        # code...
        break;
}
?>